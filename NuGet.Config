<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- nuget.org is required for EF Core (SqlServer), and later for
         LibGit2Sharp, Microsoft.Web.Administration, Microsoft.Data.SqlClient,
         FluentFTP/SSH.NET, etc. Keep this as the only source so client
         security teams can audit exactly where packages come from. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
