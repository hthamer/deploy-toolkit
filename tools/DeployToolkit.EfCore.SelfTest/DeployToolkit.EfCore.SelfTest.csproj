<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeployToolkit.Core\DeployToolkit.Core.csproj" />
    <ProjectReference Include="..\..\src\DeployToolkit.Core.EfCore\DeployToolkit.Core.EfCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The registry model + migrations are provider-neutral, so the same
         store that production runs against SQL Server is exercised here on
         SQLite — no SQL Server needed to prove the data-access logic. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
  </ItemGroup>

</Project>
