<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      NOTE: targets plain net8.0 (retarget to net10.0 on your dev machine —
      one-line change) so the suite RUNS headless on Linux/CI against the
      pure (non-WinForms) net8.0 asset of DeployToolkit.AppKit — see the
      multi-target explanation in that csproj. The suite deliberately NEVER
      instantiates any WinForms Form or Control, so it needs no
      Microsoft.WindowsDesktop.App shared framework (which does not exist
      off-Windows); the WinForms layer of AppKit is verified by compilation
      only.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DeployToolkit.AppKit.SelfTest</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Resolves AppKit's pure net8.0 asset (no WinForms framework flows). -->
    <ProjectReference Include="..\..\src\DeployToolkit.AppKit\DeployToolkit.AppKit.csproj" />
  </ItemGroup>

</Project>
